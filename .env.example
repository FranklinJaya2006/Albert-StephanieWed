# Local development. Copy to apps/back/.env (the backend) and to .env (docker-compose.yml).
# The production values are in .env.prod.example.

# apps/back
PORT=4000
# Set a unique password with at least 8 characters. Never commit the actual value.
WEDDING_ADMIN_USERNAME=
WEDDING_ADMIN_PASSWORD=
# Optional; defaults to apps/back/data/wedding.sqlite locally.
# WEDDING_DB_PATH=
# For development-only uninvited form trials, BOTH must be set. Never enable on the live server.
# NODE_ENV=test
# WEDDING_ALLOW_TEST_RESERVATIONS=true

# docker-compose.yml (local n8n + WAHA)
WAHA_API_KEY=change_me
