# Local development. Copy to apps/back/.env (the backend) and to .env (docker-compose.yml).
# The production values are in .env.prod.example.

# apps/back
PORT=4000
# Opens the photo booth admin page: /admin?key=<this value>
BOOTH_ADMIN_KEY=change_me

# docker-compose.yml (local n8n + WAHA)
WAHA_API_KEY=change_me
