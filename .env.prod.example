# Copy to /opt/birdies-gift/.env ON THE SERVER and fill in. Never commit the real file.
# Generate secrets with:  openssl rand -hex 24

# Where CI pushes the images (lowercase). Images: <prefix>-edge and <prefix>-back.
IMAGE_PREFIX=ghcr.io/franklinjaya2006/albert-stephaniewed

# Three DNS A records pointing at the server's IP.
DOMAIN_WEB=undangan.example.com
DOMAIN_BOOTH=booth.example.com
DOMAIN_N8N=n8n.example.com
# Let's Encrypt contact for certificate notices.
ACME_EMAIL=you@example.com

# Opens the booth admin page: https://<DOMAIN_BOOTH>/admin?key=<this value>
BOOTH_ADMIN_KEY=

# Encrypts credentials saved in n8n. Set once and never change it, or saved credentials break.
N8N_ENCRYPTION_KEY=

WAHA_API_KEY=

# Optional: pin versions instead of following :latest.
# N8N_VERSION=
# WAHA_VERSION=
