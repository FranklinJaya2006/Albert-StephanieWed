# Copy to /opt/birdies-gift/.env ON THE SERVER and fill in. Never commit the real file.
# Generate secrets with:  openssl rand -hex 24

# Where CI pushes the images (lowercase). Images: <prefix>-web, -admin, -back and -edge.
IMAGE_PREFIX=ghcr.io/franklinjaya2006/albert-stephaniewed

# Three DNS A records pointing at the server's IP.
DOMAIN_WEB=undangan.example.com
DOMAIN_BOOTH=booth.example.com
DOMAIN_N8N=n8n.example.com
# Let's Encrypt contact for certificate notices.
ACME_EMAIL=you@example.com

# Server-only credentials for guest admin; use a unique password, at least 8 characters.
WEDDING_ADMIN_USERNAME=
WEDDING_ADMIN_PASSWORD=

# Encrypts credentials saved in n8n. Set once and never change it, or saved credentials break.
N8N_ENCRYPTION_KEY=

WAHA_API_KEY=

# Optional: pin versions instead of following :latest.
# N8N_VERSION=
# WAHA_VERSION=

# Component tags are managed by update-service.sh in .image-tags.env on the VPS.
# IMAGE_TAG is only the fallback used for first bootstrap (defaults to latest).

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > Docker). Secret: server .env only.
CLOUDFLARE_TUNNEL_TOKEN=
