    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Kind Words from the wedding_wishes Data Table, one row per wish, oldest first. The time is UTC.\nconst rows = $input.all()\n  .map((item) => item.json)\n  .filter((row) => row && row.id !== undefined && String(row.message || '').trim());\nrows.sort((a, b) => Number(a.id) - Number(b.id));\nreturn rows.map((row) => ({\n  json: { id: String(row.id), time: String(row.createdAt || '').replace('T', ' ').slice(0, 19), name: row.name || '', message: row.message },\n}));\n"
      },
