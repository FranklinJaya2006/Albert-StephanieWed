    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Compares the Google Sheet with the wedding_guests Data Table.\n// The sheet owns name, pax (the number of people, also the most the guest may confirm) and table; the Data Table owns RSVP and check-in. A row with no token is a\n// new guest (a token is made for it next); a token the table already knows is an update; a token the table\n// does not know yet (for example the fixed test tokens) creates that guest with exactly that token.\nconst TOKEN = /^(?:[a-f0-9]{8}|[a-f0-9]{64})$/; // 8 hex characters (older 64-hex tokens are fine too)\nconst sheetRows = $('Read guest sheet').all().map((item) => item.json);\nconst known = new Set($input.all().map((item) => item.json).filter((row) => row && row.id !== undefined && row.token).map((row) => row.token));\nconst seen = new Set();\nconst out = [];\nfor (const row of sheetRows) {\n  const name = String(row.name ?? '').trim();\n  if (!name) continue; // empty line in the sheet\n  const pax = Math.floor(Number(row.pax));\n  const base = {\n    row_number: row.row_number,\n    name,\n    max_guests: pax > 0 ? pax : 1,\n    pax: pax > 0 ? pax : 0,\n    table_name: String(row.table ?? '').trim(),\n  };\n  const raw = String(row.token ?? '').trim().toLowerCase();\n  if (raw && !TOKEN.test(raw)) { out.push({ json: { ...base, op: 'bad', reason: 'invalid', rawToken: String(row.token).trim() } }); continue; }\n  if (raw && seen.has(raw)) { out.push({ json: { ...base, op: 'bad', reason: 'duplicate', rawToken: raw } }); continue; }\n  if (raw) seen.add(raw);\n  out.push({ json: { ...base, op: raw && known.has(raw) ? 'update' : 'create', existingToken: raw } });\n}\nreturn out;\n"
      },
      "id": "2909a34e-8c58-498b-bcd7-d10572c4adfa",
      "name": "Plan sync",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        40
      ]
    },
    {
      "parameters": {
        "action": "generate",
        "encodingType": "hex",
        "stringLength": 8,
        "dataPropertyName": "token"
      },
      "id": "034becb5-e1b5-4256-ba03-42a05cd887e0",
      "name": "New token",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        200,
        40
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Every item already has a freshly generated token. Keep the sheet's own token when it has one.\n// Short tokens can (rarely) repeat: a new token that is already taken is not used, and the row is told to sync again.\nconst blank = {\n  phone: '', title: '', invite_sent_at: '', rsvp_status: '', rsvp_event: '', rsvp_guests: 0,\n  rsvp_request_key: '', rsvp_at: '', reception_checkin_at: '',\n};\nconst items = $input.all().map((item) => item.json);\nconst taken = new Set($('Get guests').all().map((item) => item.json.token).filter(Boolean));\nfor (const row of items) if (row.existingToken) taken.add(row.existingToken);\nreturn items.map((row) => {\n  if (row.op === 'bad') return { json: row };\n  if (row.existingToken) return { json: { ...blank, ...row, token: row.existingToken } };\n  if (taken.has(row.token)) return { json: { ...row, op: 'bad', reason: 'collision', rawToken: '' } };\n  taken.add(row.token);\n  return { json: { ...blank, ...row } };\n});\n"
      },
      "id": "5882042c-6ac7-4658-ae82-94c4cf629ab9",
      "name": "Resolve",
      "type": "n8n-nodes-base.code",
