    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// What goes back into the sheet for each row: its token, its personal link and where the guest stands.\nconst siteUrl = String($('Settings').first().json.siteUrl).replace(/\\/+$/, '');\nconst plan = $('Resolve').all().map((item) => item.json);\nconst statusOf = (row) => {\n  const parts = [];\n  if (row.rsvp_status === 'yes') parts.push(`Hadir${row.rsvp_event ? ` (${row.rsvp_event})` : ''}, ${Number(row.rsvp_guests) || 0} orang`);\n  else if (row.rsvp_status === 'no') parts.push('Tidak hadir');\n  else parts.push('Belum RSVP');\n  if (row.ceremony_checkin_at) parts.push('sudah check-in pemberkatan');\n  if (row.reception_checkin_at) parts.push('sudah check-in resepsi');\n  return parts.join(' · ');\n};\nconst out = [];\nfor (const { json: row } of $input.all()) {\n  if (row.op === 'bad') {\n    const why = row.reason === 'duplicate' ? 'Token dobel: kosongkan sel token' : 'Token tidak valid: kosongkan sel token';\n    out.push({ json: { row_number: row.row_number, token: row.rawToken, link: '', status: why } });\n    continue;\n  }\n  const planned = plan.find((item) => item.op !== 'bad' && item.token === row.token);\n  if (!planned) continue;\n  out.push({ json: { row_number: planned.row_number, token: row.token, link: `${siteUrl}/AlbertStephanie/${row.token}`, status: statusOf(row) } });\n}\nreturn out;\n"
      },
