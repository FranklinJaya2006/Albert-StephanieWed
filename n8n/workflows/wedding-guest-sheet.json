    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// A guest has just RSVPed (the Guest API called this workflow with their token): work out the one sheet row to refresh.\n// Nothing is created, nothing else is touched. A token that is not in the Data Table or not in the sheet changes nothing.\nconst token = String($('RSVP update webhook').first().json.body?.token ?? '').trim().toLowerCase();\nconst siteUrl = String($('Settings (RSVP)').first().json.siteUrl).replace(/\\/+$/, '');\nconst guest = $input.all().map((item) => item.json).find((row) => row && row.token === token);\nconst sheetRow = $('Read sheet row').all().map((item) => item.json).find((row) => String(row.token ?? '').trim().toLowerCase() === token);\nif (!token || !guest || !sheetRow) return [];\nconst statusOf = (row) => {\n  const parts = [];\n  if (row.rsvp_status === 'yes') parts.push(`Hadir, ${Number(row.rsvp_guests) || 0} orang`);\n  else if (row.rsvp_status === 'no') parts.push('Tidak hadir');\n  else parts.push('Belum RSVP');\n  if (row.reception_checkin_at) parts.push('sudah check-in');\n  return parts.join(' · ');\n};\nreturn [{ json: { row_number: sheetRow.row_number, token, link: `${siteUrl}/AlbertStephanie/${token}`, status: statusOf(guest) } }];\n"
      },
