    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Every item already has a freshly generated token. Keep the sheet's own token when it has one.\nconst blank = {\n  phone: '', title: '', invite_sent_at: '', rsvp_status: '', rsvp_event: '', rsvp_guests: 0,\n  rsvp_request_key: '', rsvp_at: '', ceremony_checkin_at: '', reception_checkin_at: '',\n};\nreturn $input.all().map(({ json: row }) => ({\n  json: row.op === 'bad' ? row : { ...blank, ...row, token: row.existingToken || row.token },\n}));\n"
      },
