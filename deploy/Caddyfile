{
	email {$ACME_EMAIL}
}

(frontend) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	# Vite fingerprints everything under /assets, so it can be cached forever; every other file
	# (index.html, photos) is revalidated so a new deploy shows up right away.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@revalidate not path /assets/*
	header @revalidate Cache-Control "no-cache"
	reverse_proxy {args[0]}
}

{$DOMAIN_WEB} {
	handle /api/wedding/* {
		reverse_proxy back:4000
	}
	handle {
		import frontend web:80
	}
}

# The former booth domain now serves guest admin. HTTPS enables camera scanning.
{$DOMAIN_BOOTH} {
	handle /invitation {
		redir https://{$DOMAIN_WEB}/?{query} 302
	}
	handle /api/wedding/* {
		reverse_proxy back:4000
	}
	handle {
		import frontend admin:80
	}
}

{$DOMAIN_N8N} {
	reverse_proxy n8n:5678
}
