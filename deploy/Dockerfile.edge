# Lightweight HTTPS router; frontend images are built independently.
FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
RUN DOMAIN_WEB=web.example.test DOMAIN_BOOTH=admin.example.test DOMAIN_N8N=n8n.example.test \
    ACME_EMAIL=ci@example.test caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
